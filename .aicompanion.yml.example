# aicompanion configuration
# Copy to .aicompanion.yml and customise.
# CLI flags and AICOMPANION_<KEY> env vars override these values.

# agent: claude        # pin to one agent; default: auto-detect
#                      # options: claude, codex, gemini, copilot, opencode
# model: sonnet        # pin to a specific model the agent advertises; default: agent's choice
#                      # matched flexibly: "sonnet" → "claude-sonnet-4-6", "opus" → "claude-opus-4-7", etc.
# agent_extra_args: [] # extra CLI args appended to the agent command

# ── Per-skill model overrides ───────────────────────────────────────────────
# Used by the interactive create-prd / create-tech-spec / create-tasks commands
# (not by `run`). Override-priority: command-line --model > skills.<name>.model >
# AICOMPANION_SKILLS_<NAME>_MODEL env var > global `model` above > agent default.
#
# skills:
#   create-prd:        { model: opus }     # high-leverage thinking — pay for opus
#   create-tech-spec:  { model: opus }
#   create-tasks:      { model: sonnet }   # mechanical decomposition — sonnet is fine

features_dir: features        # parent dir of feature subfolders, each with a tasks/ child.
                              #   features/<feature-name>/tasks/01-task.md
                              # The runner iterates every feature alphabetically and ships
                              # each feature's tasks in order. Drop one feature in there to
                              # ship a single feature; drop several to ship them all.
task_extensions: [md, txt]   # only files with these extensions are treated as tasks
task_sort: alphabetical       # alphabetical | none — applies to both feature dirs and tasks

project_dir: .               # project root passed to the agent ACP session

# test_command: mvn test -q  # defaults: auto-detect from pom.xml / package.json / Makefile
# verify_commands:            # ordered pipeline; first failure stops and feeds the fix loop.
#   - npm run lint            # put cheap checks FIRST (lint → typecheck → test) so failures
#   - npm run typecheck       # short-circuit before a full suite. Overrides test_command.
#   - npm test                # When unset, auto-detects this ordering from package.json
#                             # scripts or Makefile targets if lint/typecheck exist.
test_enabled: true            # run tests after each task
test_timeout_min: 30          # kill the test command after N minutes, counting it as a failure (0 = no limit)
stop_on_failure: true         # stop the whole run if tests still fail after max_fix_attempts
max_fix_attempts: 3           # on test failure, feed the output back to the agent and retry up to N times (0 = disable)

session_timeout_min: 10       # ACP session timeout per task (minutes)
reuse_session: true           # keep one ACP session across all tasks (false = fresh session per task)

report_dir: .aicompanion/logs # directory for per-task markdown summary logs
report_enabled: true          # write a .md log after each task

log_tool_calls: true          # print [read]/[write]/[perm] events to console
log_thoughts: false           # print agent reasoning / working to console

yolo: true                    # pass --yolo to the agent (auto-approve its tool calls)

# ── Token-saving options ────────────────────────────────────────────────────
fix_output_max_lines: 120     # cap test output sent on fix retries (0 = unbounded)
task_preamble_strip: true     # drop content before the first Markdown heading in each task file
init_instructions: true       # send the summary-format rules once per session instead of per task
compact_after_n_tasks: 0      # recycle the ACP session every N tasks (0 = never; sends a short handoff)
compact_at_context_pct: 70    # recycle when agent-reported context fill ≥ N% (0 = off; no-op without usage reports)
pre_check_tests: false        # run tests before the agent — skip the LLM call when they already pass
max_tokens_per_run: 0         # estimated-token budget per run; 0 = unlimited (run --dry-run-tokens to size)
